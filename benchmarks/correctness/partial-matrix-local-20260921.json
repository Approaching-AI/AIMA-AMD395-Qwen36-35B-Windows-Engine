    "text": "// Reuse the independent original-group audit, including its lossless row,\n// prior-admission, fallback and untouched-rejection assertions.\n#define main generated_partial_matrix_audit_main\n#include \"tests/native/partial_matrix_group_host.cpp\"\n#undef main\n#include <fstream>\n#include <iostream>\n#include <stdexcept>\n\nstd::vector<uint16_t> read(const char* path, size_t count) {\n    std::ifstream f(path,std::ios::binary|std::ios::ate);\n    if (!f || f.tellg()!=std::streamoff(count*2u)) throw std::runtime_error(\"capture extent\");\n    std::vector<uint16_t> x(count); f.seekg(0); f.read(reinterpret_cast<char*>(x.data()),count*2u);\n    if (!f) throw std::runtime_error(\"capture read\");\n    return x;\n}\nint main(int argc,char** argv) try {\n    if (argc!=4) throw std::runtime_error(\"Q K 7169|8192\");\n    const unsigned tokens=std::stoul(argv[3]);\n    if (tokens!=7169u && tokens!=8192u) throw std::runtime_error(\"shape\");\n    auto q=read(argv[1],7169u*4096u),k=read(argv[2],7169u*512u);\n    for (auto pair : {std::make_pair(&q,4096u),std::make_pair(&k,512u)}) {\n        const auto initial=*pair.first;\n        pair.first->insert(pair.first->end(),initial.begin(),initial.begin()+size_t(tokens-7169u)*pair.second);\n    }\n    Counts count; uint64_t dots=0,eligible=0;\n    for (unsigned sample=0;sample<128u;++sample) {\n        const unsigned query=32u+sample*(tokens-33u)/127u;\n        const unsigned prefix=(query/32u)*32u;\n        for (unsigned head=0;head<16u;++head) for (unsigned key_sample=0;key_sample<32u;++key_sample) {\n            const unsigned key=key_sample*prefix/32u;\n            const uint16_t* a=q.data()+(size_t(query)*16u+head)*256u;\n            const uint16_t* b=k.data()+(size_t(key)*2u+head/8u)*256u;\n            bool narrow=true;\n            for (unsigned i=0;i<256u;++i)\n                narrow &= qrt_sm121_narrow_f32_carry::eligible(a[i]) && qrt_sm121_narrow_f32_carry::eligible(b[i]);\n            ++dots; if (!narrow) continue; ++eligible;\n            original::Value carry{0u,-133,false}; float carried=0.0f;\n            for (unsigned g=0;g<16u;++g) carried=group(carried,carry,a+g*16u,b+g*16u,count);\n        }\n    }\n    std::cout << \"{\\\"kind\\\":\\\"captured_qk_partial_matrix_host_sample\\\",\\\"tokens\\\":\" << tokens\n        << \",\\\"source_capture_tokens\\\":7169,\\\"repeated_rows\\\":\" << tokens-7169u\n        << \",\\\"query_samples\\\":128,\\\"heads\\\":16,\\\"keys_per_query_head\\\":32,\\\"sampled_dots\\\":\" << dots\n        << \",\\\"domain_eligible_dots\\\":\" << eligible << \",\\\"ordered_groups\\\":\" << count.groups\n        << \",\\\"original_matrix_admitted\\\":\" << count.original_admitted\n        << \",\\\"additional_remainder_admitted\\\":\" << count.remainder_admitted\n        << \",\\\"additional_partial_admitted\\\":\" << count.partial_admitted\n        << \",\\\"partial_scalar_products\\\":\" << count.sparse_products\n        << \",\\\"original_narrow_fallback\\\":\" << count.rejected\n        << \",\\\"lossless_prepared_words\\\":\" << count.words\n        << \",\\\"raw_carry_mismatches\\\":0,\\\"host_arithmetic_only\\\":true,\\\"gpu_executed\\\":false,\\\"inference_acceptance\\\":false}\\n\";\n} catch (const std::exception& e) { std::cerr << e.what() << '\\n'; return 2; }\n"
  },
