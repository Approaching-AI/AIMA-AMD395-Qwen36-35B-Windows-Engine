    "text": "$ErrorActionPreference='Stop';$ProgressPreference='SilentlyContinue';[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false)\nif(-not [Environment]::MachineName.Equals('baiying',[StringComparison]::OrdinalIgnoreCase)){throw 'Requires baiying'}\n$sourcePath='D:\\projects\\final-query-liveness-native-source-r1.json'\n$m=[IO.File]::ReadAllText($sourcePath)|ConvertFrom-Json\nfunction Verify-File([string]$Path,[string]$Sha){if((Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant() -ne $Sha){throw ('Changed input: '+$Path)}}\nVerify-File $PSCommandPath $m.script_sha256\n$repo=$m.repo.Replace('/','\\');$seed=$m.seed.Replace('/','\\');$sha=$m.source_commit\n$bundle=Join-Path 'D:\\projects' $m.bundle;Verify-File $bundle $m.bundle_sha256\nif(-not(Test-Path $repo)){\n & git -C $seed fetch $bundle HEAD;if($LASTEXITCODE -ne 0){throw 'Fetch failed'}\n & git -C $seed worktree add --detach $repo $sha;if($LASTEXITCODE -ne 0){throw 'Worktree creation failed'}\n}\nif((& git -C $repo rev-parse HEAD).Trim() -ne $sha -or @(& git -C $repo status --porcelain).Count -ne 0){throw 'Source mismatch'}\nforeach($item in $m.source_sha256.PSObject.Properties){Verify-File (Join-Path $repo $item.Name) $item.Value}\nfunction Check-Run([string]$Path){\n $r=[IO.File]::ReadAllText($Path)|ConvertFrom-Json\n if($r.reason -ne 'completed' -or $r.exit_code -ne 0 -or -not $r.host_checks_pass){throw ('Incomplete prerequisite '+$Path)}\n return (Get-FileHash $Path -Algorithm SHA256).Hash.ToLowerInvariant()\n}\n$priorPath=Join-Path $seed $m.prior_completed_run\nVerify-File $priorPath $m.prior_completed_run_sha256\n$null=Check-Run $priorPath\n$build=Join-Path $repo 'build\\final-query-liveness-whole-provider'\n$out=Join-Path $repo 'build\\final-query-liveness-build-r1';$specPath=$out+'.json'\nforeach($p in @($build,$out,$specPath)){if(Test-Path $p){throw 'Evidence exists'}}\n$null=New-Item -ItemType Directory -Path (Join-Path $repo 'build') -Force\n$inputs=@()\nforeach($file in @(& git -C $repo ls-files 'native/*.c' 'native/*.cpp' 'native/*.h' 'native/**/*.c' 'native/**/*.cpp' 'native/**/*.h' 'tests/native/*.cpp' 'tests/native/*.h' 'scripts/baiying_build_whole_provider.ps1' 'scripts/baiying_guarded_inference.ps1')){\n $inputs+=@{file=$file;sha256=(Get-FileHash (Join-Path $repo $file) -Algorithm SHA256).Hash.ToLowerInvariant()}\n}\n$spec=[ordered]@{\n executable='C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe'\n arguments=@('-NoLogo','-NoProfile','-NonInteractive','-File',(Join-Path $repo 'scripts\\baiying_build_whole_provider.ps1'),'-OutDir',$build,'-DppReduction','1','-CompactNormalize','1','-HawkeyeReplayLanes','4','-CompileTimeoutSeconds','240')\n working_directory=$repo;repo_commit=$sha;source_inputs=$inputs\n command_file=$PSCommandPath;command_file_sha256=$m.script_sha256;source_manifest_sha256=(Get-FileHash $sourcePath -Algorithm SHA256).Hash.ToLowerInvariant()\n model='none; native whole-provider compile';model_loaded=$false;inference_acceptance=$false;performance_acceptance=$false\n purpose='Compile the optional final-query liveness whole provider using the same DPP/compact normalization/replay-lanes configuration as the retained control. Preserve full-prefix QKV and resident KV capture; one explicit terminal query may use the existing exact suffix ABI. Default off, cold q8192 single-last-row scope only. Multi-row, checkpoint, chunked, prefix and MTP consumers remain unchanged. No numerical or model acceptance is inferred from compilation.'\n}\n[IO.File]::WriteAllText($specPath,($spec|ConvertTo-Json -Depth 12),[Text.UTF8Encoding]::new($false))\n$env:PATH='C:\\Program Files\\AMD\\ROCm\\7.1\\bin;'+$env:PATH\n& (Join-Path $repo 'scripts\\baiying_guarded_inference.ps1') -SpecPath $specPath -OutDir $out -TimeoutSeconds 300|Out-Null\n$r=[IO.File]::ReadAllText((Join-Path $out 'run-record.json'))|ConvertFrom-Json\n$r|Select-Object reason,exit_code,wall_ms,host_checks|ConvertTo-Json -Depth 5\nif($r.reason -ne 'completed' -or $r.exit_code -ne 0 -or -not $r.host_checks_pass){throw 'Native build or host check failed'}\n$meta=[IO.File]::ReadAllText((Join-Path $build 'build-provenance.json'))|ConvertFrom-Json\nif($meta.repo_commit -ne $sha -or $meta.dirty_tree -or -not $meta.sm121_dpp_reduction -or -not $meta.sm121_compact_normalize -or $meta.hawkeye_replay_lanes -ne 4){throw 'Build configuration mismatch'}\nif($meta.source_sha256 -ne $m.source_sha256.'native/providers/whole_provider.cpp' -or $meta.hawkeye_dispatch_policy_sha256 -ne $m.source_sha256.'native/providers/hawkeye_dispatch_policy.h'){throw 'Compiled source mismatch'}\n"
