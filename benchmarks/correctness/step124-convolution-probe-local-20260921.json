      "text": "from pathlib import Path\nimport hashlib,json,os,re,shutil,socket,subprocess\n\nB=Path(__file__).resolve().parent;P=Path('<runtime-checkout>')\nread=lambda p:json.loads(p.read_text(encoding='utf-8-sig'))\nsha=lambda p:hashlib.file_digest(p.open('rb'),'sha256').hexdigest()\nproof_path=B/'step124-convolution-host-r1/comparison.json';proof=read(proof_path)\nassert proof['summary']['output_bf16_mismatches']==proof['summary']['active_history_bf16_mismatches']==0\nrow=next(r for r in proof['results'] if r['position']==263291 and r['layer']==0)\n# The previously verified command names immutable original operands.\nold=row['command_receipt']['command'];args=old[1:8]\nfor item in proof['verified_current_header_inputs']:assert sha(P/item['file'])==item['sha256']\nfor label,path in zip(('qkv','before','after','weights','silu','expected'),args[:6]):assert Path(path).is_file(),label\nD=B/'convolution-probe-host-r2';D.mkdir();include=D/'include/hip';include.mkdir(parents=True)\nmock=B/'convolution_probe_hip_mock_r1.h';shutil.copyfile(mock,include/'hip_runtime.h')\nsource=P/'tools/q1_convolution_hip_probe.cpp';exe=D/'probe-host-mock'\ncommand=['c++','-std=c++17','-O2','-ffp-contract=off','-Wall','-Wextra','-Werror','-fsanitize=address,undefined',\n    '-fno-sanitize-recover=all','-I',str(D/'include'),str(source),'-o',str(exe)]\ncompiled=subprocess.run(command,capture_output=True,text=True,timeout=45)\nwith (D/'compile.json').open('x') as f:json.dump(dict(command=command,returncode=compiled.returncode,stdout=compiled.stdout,stderr=compiled.stderr),f,indent=2);f.write('\\n')\ncompiled.check_returncode()\nresults=[]\nfor fault in ('none','carrier','ring_guard','output_guard','stored_current','unowned_ring','input_current','input_weight','input_table'):\n    env=dict(os.environ);env['QRT_CONVOLUTION_TEST_FAULT']='' if fault=='none' else fault\n    cmd=[str(exe),*args];p=subprocess.run(cmd,capture_output=True,text=True,env=env,timeout=20)\n    rows=[json.loads(line) for line in p.stdout.splitlines() if line.startswith('{')]\n    with (D/(fault+'.json')).open('x') as f:json.dump(dict(command=cmd,returncode=p.returncode,stdout=p.stdout,stderr=p.stderr),f,indent=2);f.write('\\n')\n    accepted=fault=='none' and p.returncode==0 and len(rows)==3 and all(x.get('passed',True) for x in rows)\n    if fault=='none':assert accepted\n    else:assert p.returncode in (1,2), (fault,p.stdout,p.stderr)\n    if fault=='carrier':assert all(x['output_bf16_mismatches']==0 and x['output_f32_carrier_bit_mismatches']==1 for x in rows[:2])\n    if fault in ('ring_guard','output_guard'):assert all(x['guard_mismatches']==1 for x in rows[:2])\n    if fault=='stored_current':assert all(x['stored_current_mismatches']==1 for x in rows[:2])\n    if fault=='unowned_ring':assert all(x['unowned_ring_mismatches']==1 for x in rows[:2])\n    if fault.startswith('input_'):assert 'immutable input changed' in p.stderr\n    results.append(dict(fault=fault,command=cmd,returncode=p.returncode,stdout=p.stdout,stderr=p.stderr,\n        required_outcome='original reference matches' if fault=='none' else 'fault rejected',passed=True))\n    print(json.dumps(dict(fault=fault,returncode=p.returncode,observer_check_passed=True)),flush=True)\ntodo=[source];seen=set()\nwhile todo:\n    p=todo.pop().resolve()\n    if p in seen:continue\n    seen.add(p)\n    for inc in re.findall(r'^\\s*#include \"([^\"\\n]+)\"',p.read_text(),re.M):todo.append((p.parent/inc).resolve())\nrecord=dict(kind='q1_convolution_probe_observer_host_mock',host=socket.gethostname(),\n    source_parent_commit=subprocess.check_output(['git','rev-parse','HEAD'],cwd=P,text=True,timeout=10).strip(),\n    source_inputs={str(p.relative_to(P)):sha(p) for p in sorted(seen)},\n    mock_sha256=sha(mock),compiler_command=command,executable_sha256=sha(exe),observer_sha256=sha(Path(__file__)),\n    original_reference_arithmetic_proof_sha256=sha(proof_path),selected=dict(position=263291,layer=0),\n    prior_negative_controls_sha256=sha(B/'convolution-probe-host-r1/old-observer-negative-controls.json'),positive_cases=1,rejected_faults=8,results=results,\n    host_execution_mock_only=True,native_hip_compiled=False,gpu_executed=False,\n    inference_acceptance=False,performance_acceptance=False,release_qualified=False)\nout=D/'comparison.json'\nwith out.open('x') as f:json.dump(record,f,indent=2,allow_nan=False);f.write('\\n')\nprint(json.dumps(dict(file=str(out.relative_to(B)),sha256=sha(out),inputs=len(seen))),flush=True)\n"
    }
