      "text": "#pragma once\n// Controller-only probe-observer validation. Never compiled into native HIP.\n#include <cstdlib>\n#include <cstring>\n#include <cstdint>\n#include <string>\n#include <type_traits>\n#define __device__\n#define __global__\n#define __shared__ static\ninline void __syncthreads() {}\nstruct dim3 { unsigned x,y,z; dim3(unsigned a=1,unsigned b=1,unsigned c=1):x(a),y(b),z(c){} };\ninline dim3 blockIdx,blockDim,threadIdx;\nusing hipError_t=int;using hipEvent_t=int*;\nconstexpr int hipSuccess=0,hipErrorNotReady=1,hipMemcpyHostToDevice=2,hipMemcpyDeviceToHost=3,hipEventDisableTiming=4;\nstruct hipDeviceProp_t { char gcnArchName[64]; };\ninline const char* hipGetErrorString(int) { return \"controller HIP mock error\"; }\ninline int hipMalloc(void** p,size_t n) { *p=std::malloc(n);return *p?0:2; }\ninline int hipFree(void* p) { std::free(p);return 0; }\ninline int hipMemcpy(void* to,const void* from,size_t n,int) { std::memcpy(to,from,n);return 0; }\ninline int hipGetDeviceProperties(hipDeviceProp_t* p,int) { std::strcpy(p->gcnArchName,\"gfx1151-controller-mock\");return 0; }\ninline int hipGetLastError() { return 0; }\ninline int hipEventCreateWithFlags(hipEvent_t* e,unsigned) { *e=new int(0);return 0; }\ninline int hipEventRecord(hipEvent_t,void*) { return 0; }\ninline int hipEventQuery(hipEvent_t) { return 0; }\ninline int hipEventDestroy(hipEvent_t e) { delete e;return 0; }\ntemplate<class T> void qrt_mock_fault(const float* current,T* ring,const uint16_t* weights,\n    float* output,size_t position,const unsigned char* silu) {\n    const char* value=std::getenv(\"QRT_CONVOLUTION_TEST_FAULT\");const std::string fault=value?value:\"\";\n    if(fault==\"carrier\") { uint32_t bits;std::memcpy(&bits,output,4);bits^=1u;std::memcpy(output,&bits,4); }\n    if(fault==\"ring_guard\") ring[-1]=T(0);\n    if(fault==\"output_guard\") output[-1]=0.0f;\n    if(fault==\"stored_current\") ring[(position%4u)*8192u]=T(0);\n    if(fault==\"unowned_ring\") ring[((position+1u)%4u)*8192u]=T(0);\n    if(fault==\"input_current\") const_cast<float*>(current)[0]+=1.0f;\n    if(fault==\"input_weight\") const_cast<uint16_t*>(weights)[0]^=1u;\n    if(fault==\"input_table\") const_cast<unsigned char*>(silu)[0]^=1u;\n}\n#define hipLaunchKernelGGL(kernel,grid,block,shared,stream,...) do { \\\n    const dim3 qrt_mock_grid=(grid);blockDim=(block); \\\n    for(blockIdx.x=0;blockIdx.x<qrt_mock_grid.x;++blockIdx.x) \\\n        for(threadIdx.x=0;threadIdx.x<blockDim.x;++threadIdx.x) kernel(__VA_ARGS__); \\\n    qrt_mock_fault(__VA_ARGS__); \\\n} while(false)\n"
