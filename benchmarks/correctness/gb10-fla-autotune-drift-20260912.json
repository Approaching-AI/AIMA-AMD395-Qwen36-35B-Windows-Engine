  "replay_command_source": "from pathlib import Path\nimport hashlib,json,importlib,inspect,socket,time,os\nroot=Path('/work');inputs_root=Path('/inputs');out=root/'probe';out.mkdir(exist_ok=False)\nassert socket.gethostname()=='aitopatom-66c4'\nmanifest=json.loads((inputs_root/'inputs.json').read_text())\nfor name,digest in manifest.items():assert hashlib.sha256((inputs_root/name).read_bytes()).hexdigest()==digest,name\nimport torch,triton\nfrom triton.runtime.autotuner import Autotuner\nassert torch.cuda.device_count()==1 and torch.cuda.get_device_capability()==(12,1)\ntorch.set_num_threads(2);torch.cuda.set_device(0)\ntriton.set_allocator(lambda size,alignment,stream: torch.empty(size,dtype=torch.uint8,device='cuda'))\nassert torch.cuda.mem_get_info()[0]>3*(1<<30)\nsource_manifest=json.loads((inputs_root/'sources.json').read_text());base=Path(importlib.import_module('vllm.model_executor.layers.fla').__file__).parent\nfor name,digest in source_manifest.items():assert hashlib.sha256((base.parent/name).read_bytes()).hexdigest()==digest,name\nassert hashlib.sha256(Path(inspect.getsourcefile(Autotuner)).read_bytes()).hexdigest()==json.loads((inputs_root/'runtime-source.json').read_text())['autotuner_sha256']\nrecords=json.loads((root/'autotune.json').read_text());old=[x for x in records if x['container']=='qrt-gb10-token-matrix-20260911-r2'];new=[x for x in records if x['container']!='qrt-gb10-token-matrix-20260911-r2']\nmodules={'merge_16x16_to_64x64_inverse_kernel':'solve_tril','chunk_fwd_kernel_o':'chunk_o','recompute_w_u_fwd_kernel':'wy_fast','chunk_local_cumsum_scalar_kernel':'cumsum','chunk_scaled_dot_kkt_fwd_kernel':'chunk_scaled_dot_kkt','chunk_gated_delta_rule_fwd_kernel_h_blockdim64':'chunk_delta_h'}\ndef selection(rows):\n result={}\n for r in rows:\n  name=Path(r['path']).name.removesuffix('.autotune.json')\n  if name=='chunk_fwd_kernel_o' and r['value']['key'][3]!=64:continue\n  config,timing=min(r['value']['configs_timings'],key=lambda v:v[1]);result[name]=config\n return result\nold,new=selection(old),selection(new);assert set(old)==set(modules) and set(new)==set(modules)\nobjects={}\nfor name,module in modules.items():\n obj=getattr(importlib.import_module('vllm.model_executor.layers.fla.ops.'+module),name)\n while not isinstance(obj,Autotuner):obj=obj.fn\n objects[name]=(obj,list(obj.configs))\ndef pin(configs):\n for name,c in configs.items():\n  obj,allowed=objects[name];matches=[x for x in allowed if x.__dict__==c];assert len(matches)==1,(name,c)\n  obj.configs=matches;obj.cache.clear()\ndef tensor(name,dtype,shape):return torch.frombuffer(bytearray((inputs_root/name).read_bytes()),dtype=dtype).reshape(shape).cuda()\nT=7169\ninputs={name:tensor('full-'+name+'-'+suffix+'.bin',dtype,shape) for name,suffix,dtype,shape in [('q','bf16',torch.bfloat16,(1,T,16,128)),('k','bf16',torch.bfloat16,(1,T,16,128)),('v','bf16',torch.bfloat16,(1,T,32,128)),('g','f32',torch.float32,(1,T,32)),('beta','bf16',torch.bfloat16,(1,T,32)),('initial_state','f32',torch.float32,(1,32,128,128))]}\nseq=tensor('full-cu_seqlens-i32.bin',torch.int32,(2,))\nexpected_output=tensor('full-output-bf16.bin',torch.bfloat16,(1,T,32,128));expected_state=tensor('full-state-f32.bin',torch.float32,(1,32,128,128))\nnew_output=tensor('new-core-bf16.bin',torch.bfloat16,(1,1,32,128));new_state=tensor('new-state-f32.bin',torch.float32,(1,32,128,128))\nfrom vllm.model_executor.layers.fla.ops.chunk import chunk_gated_delta_rule\nresults=[]\ndef compare(a,b):\n assert a.shape==b.shape\n dtype=torch.int16 if a.dtype==torch.bfloat16 else torch.int32\n return dict(bit_mismatches=int((a.view(dtype)!=b.view(dtype)).sum().item()),elements=a.numel(),finite=bool(torch.isfinite(a).all().item()),sha256=hashlib.sha256(a.detach().cpu().contiguous().view(torch.uint8).numpy().tobytes()).hexdigest())\nvariants=[('original',old),('recent',new)]\nfor name in old:\n if old[name]!=new[name]:variants.append(('only-'+name,{**old,name:new[name]}))\nfor label,configs in variants:\n pin(configs);start=time.monotonic()\n with torch.inference_mode():o,h=chunk_gated_delta_rule(**inputs,output_final_state=True,cu_seqlens=seq,use_qk_l2norm_in_kernel=True)\n torch.cuda.synchronize()\n r=dict(variant=label,configs=configs,wall_seconds=time.monotonic()-start,old_full_output=compare(o,expected_output),old_final_state=compare(h,expected_state),new_last_output=compare(o[:,-1:],new_output),new_final_state=compare(h,new_state),last_output_sha256=hashlib.sha256(o[:,-1:].detach().cpu().contiguous().view(torch.uint8).numpy().tobytes()).hexdigest(),max_gpu_allocated=torch.cuda.max_memory_allocated())\n results.append(r);(out/(label+'.json')).write_text(json.dumps(r,indent=2)+'\\n');print(json.dumps(r),flush=True)\n assert torch.cuda.max_memory_allocated()<2*(1<<30)\n del o,h\n(out/'result.json').write_text(json.dumps(dict(host=socket.gethostname(),model_reference='saved real Qwen3.6-35B-A3B q7169 layer 0 operands',source_commit=(inputs_root/'commit.txt').read_text().strip(),command_file=__file__,command_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),inputs=manifest,results=results),indent=2)+'\\n')\n",
